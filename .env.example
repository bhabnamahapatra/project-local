# AI Organization Dashboard - Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=postgres
DB_NAME=metrics_db
DB_USER=metrics_user
DB_PASSWORD=metrics_pass

# External API Keys (Required for data collection)
# Get your API keys from:
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# GitHub: https://github.com/settings/tokens (needs appropriate scopes)
GITHUB_TOKEN=ghp-your-github-token-here

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Cursor: Get from Cursor settings/developer section
CURSOR_API_KEY=cur-your-cursor-api-key-here

# Optional: Custom Service Ports (uncomment to override defaults)
# POSTGRES_PORT=5432
# API_PORT=5000
# DASHBOARD_PORT=3000

# Optional: API Configuration
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com
# API_RATE_LIMIT=1000

# Optional: Collector Configuration
# COLLECT_INTERVAL=3600  # Collection interval in seconds (default: 1 hour)
# COLLECT_LOG_LEVEL=INFO   # Log level: DEBUG, INFO, WARNING, ERROR

# Optional: Database Configuration
# DB_POOL_SIZE=20         # Database connection pool size
# DB_POOL_MAX_OVERFLOW=30 # Maximum overflow connections
# DB_POOL_TIMEOUT=30      # Connection timeout in seconds

# Optional: Security Configuration (Production)
# JWT_SECRET_KEY=your-jwt-secret-key-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=60
# API_SECRET_KEY=your-api-secret-key-here

# Optional: Monitoring and Logging
# ENABLE_METRICS=true     # Enable application metrics
# ENABLE_TRACING=false    # Enable distributed tracing
# LOG_LEVEL=INFO          # Application log level
# LOG_FORMAT=json         # Log format: json, text